# Variáveis para o serviço da API no Railway (lupa-insights-api).
# Copie para railway.env (gitignored), preencha e cole no painel Railway → Variables.
# Para primeiro teste use credenciais TEST- do painel Mercado Pago.

MERCADOPAGO_PUBLIC_KEY=TEST-sua-public-key
MERCADOPAGO_ACCESS_TOKEN=TEST-seu-access-token

API_PUBLIC_URL=https://lupa-cnpj-api-production.up.railway.app
FRONTEND_URL=https://lupa-insights.vercel.app
ALLOWED_ORIGINS=https://lupa-insights.vercel.app,http://localhost:4200,https://*.vercel.app

# Obrigatórias (já devem existir no Railway)
# JWT_SECRET=
# DB_URL= ou plugin MySQL Railway (MYSQL_URL)
