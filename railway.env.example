# Variáveis para o serviço da API no Railway (lupa-insights-api).
# Copie para railway.env (gitignored), preencha e cole no painel Railway → Variables.
# Guia completo: docs/CONFIGURACAO-PRODUCAO.md

# --- Perfil Spring ---
SPRING_PROFILES_ACTIVE=production

# --- JWT (obrigatório — gere valor forte, 32+ caracteres) ---
JWT_SECRET=substitua-por-segredo-forte-aleatorio
# Sessão do usuário em horas (padrão 8)
# JWT_EXPIRATION_HOURS=8

# --- Mercado Pago PRODUÇÃO (APP_USR-, não TEST-) ---
# Painel: https://www.mercadopago.com.br/developers/panel/app → Credenciais de produção
MERCADOPAGO_PUBLIC_KEY=APP_USR-sua-public-key
MERCADOPAGO_ACCESS_TOKEN=APP_USR-seu-access-token
# Painel MP → Webhooks → assinatura secreta (recomendado em produção)
MERCADOPAGO_WEBHOOK_SECRET=

# --- URLs públicas ---
API_PUBLIC_URL=https://lupa-cnpj-api-production.up.railway.app
FRONTEND_URL=https://www.lupacnpjs.com.br
ALLOWED_ORIGINS=https://www.lupacnpjs.com.br,https://lupacnpjs.com.br,https://lupa-cnpj.vercel.app,http://localhost:4200,https://*.vercel.app

# --- E-mail transacional (Resend) — reset de senha ---
# Conta: https://resend.com → verificar domínio (SPF/DKIM) → API Keys
RESEND_API_KEY=re_sua_api_key
EMAIL_FROM=noreply@lupacnpjs.com.br
EMAIL_FROM_NAME=Lupa Insights
# EMAIL_ENABLED=true

# --- Bootstrap do admin (use uma vez em produção, depois remova) ---
# Gere um segredo forte (32+ caracteres). Chame POST /auth/bootstrap-admin com header
# X-Admin-Bootstrap-Secret e remova esta variável após criar/promover sua conta.
# ADMIN_BOOTSTRAP_SECRET=substitua-por-segredo-forte-aleatorio

# --- Banco: vincule o plugin MySQL no Railway (recomendado) ---
# Variáveis automáticas: MYSQL_URL, MYSQLUSER, MYSQLPASSWORD
# Não cole MYSQL_URL em DB_URL manualmente.

# --- Opcional: API comercial CNPJ.ws ---
# CNPJ_WS_TOKEN=
# PESQUISA_RAZAO_SOCIAL=false

# --- New Relic APM (agente Java no Docker) ---
# Painel: https://one.newrelic.com → API Keys → License key
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=lupa-cnpj-api
# NEW_RELIC_ENVIRONMENT=production

# --- Homologação no Railway com credenciais TEST (só para QA, não go-live) ---
# MERCADOPAGO_PUBLIC_KEY=TEST-...
# MERCADOPAGO_ACCESS_TOKEN=TEST-...
