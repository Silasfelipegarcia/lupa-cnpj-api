# Copie para .env e preencha (nunca commite o .env):
#   cp .env.example .env
#
# Carregar antes de subir a API:
#   set -a && source .env && set +a && mvn spring-boot:run

# --- Banco (local) ---
DB_USERNAME=root
DB_PASSWORD=
# DB_URL=jdbc:mysql://127.0.0.1:3306/lupainsights?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&createDatabaseIfNotExist=true

# --- JWT (dev) ---
# JWT_SECRET=dev-secret-change-in-production-min-32-chars

# --- Mercado Pago (use credenciais de TESTE em local) ---
# Painel: https://www.mercadopago.com.br/developers/panel/app
MERCADOPAGO_PUBLIC_KEY=TEST-sua-public-key
MERCADOPAGO_ACCESS_TOKEN=TEST-seu-access-token
MERCADOPAGO_WEBHOOK_SECRET=

# URLs usadas em redirects do checkout e webhook de pagamento
FRONTEND_URL=http://localhost:4200
API_PUBLIC_URL=http://localhost:8080

# Opcional: preços em centavos (padrão Premium R$ 49,90 / Pro+ R$ 99,90)
# MERCADOPAGO_PREMIUM_PRICE_CENTS=4990
# MERCADOPAGO_PRO_PLUS_PRICE_CENTS=9990
