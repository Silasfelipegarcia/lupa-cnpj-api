# Copie para .env e preencha com suas credenciais TEST do painel Mercado Pago:
#   cp .env.example .env
#
# A API carrega o .env automaticamente (spring-dotenv) ao subir com profile local.
# Alternativa: ./scripts/start-local.sh

# --- Banco (local) ---
DB_USERNAME=root
DB_PASSWORD=
# DB_URL=jdbc:mysql://127.0.0.1:3306/lupainsights?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&createDatabaseIfNotExist=true

# --- JWT (dev) ---
# JWT_SECRET=dev-secret-change-in-production-min-32-chars
# JWT_EXPIRATION_HOURS=8

# --- Mercado Pago (use credenciais de TESTE em local) ---
# Painel: https://www.mercadopago.com.br/developers/panel/app
MERCADOPAGO_PUBLIC_KEY=TEST-sua-public-key
MERCADOPAGO_ACCESS_TOKEN=TEST-seu-access-token
MERCADOPAGO_WEBHOOK_SECRET=

# URLs usadas em redirects do checkout e webhook de pagamento
FRONTEND_URL=http://localhost:4200
API_PUBLIC_URL=http://localhost:8080

# --- E-mail transacional (Resend) — reset de senha ---
# Conta: https://resend.com
# Teste local (sem domínio verificado): use onboarding@resend.dev como remetente
# RESEND_API_KEY=re_sua_api_key
# EMAIL_FROM=onboarding@resend.dev
# EMAIL_FROM_NAME=Lupa Insights
# EMAIL_ENABLED=true
# Produção: verifique o domínio no Resend e use ex. noreply@lupacnpjs.com.br

# --- Bootstrap do primeiro admin (produção) ---
# Gere um valor forte (32+ caracteres), defina no Railway, chame POST /auth/bootstrap-admin
# e remova a variável depois de promover/criar sua conta.
# ADMIN_BOOTSTRAP_SECRET=seu-segredo-forte-aleatorio

# Opcional: preços em centavos (padrão Premium R$ 49,90 / Pro+ R$ 99,90)
# MERCADOPAGO_PREMIUM_PRICE_CENTS=4990
# MERCADOPAGO_PRO_PLUS_PRICE_CENTS=9990
